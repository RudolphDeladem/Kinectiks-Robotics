---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/kinectiks-logo.png';

interface Props {
  size?: 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
const markHeight = size === 'lg' ? 56 : 34;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <Image
    src={logoMark}
    alt=""
    height={markHeight}
    densities={[1, 2]}
    format="webp"
    class="logo-mark"
    loading="eager"
  />
  <span class="logo-word" aria-hidden="true">
    <span class="logo-word-main">Kinectiks</span>
    <span class="logo-word-sub">Robotics</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
  }

  .logo-mark {
    width: auto;
    height: 34px;
  }

  .logo--lg .logo-mark {
    height: 56px;
  }

  .logo-word {
    display: grid;
    line-height: 1;
  }

  .logo-word-main {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .logo-word-sub {
    margin-top: 0.22rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-stretch: 125%;
    font-size: 0.66rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .logo--lg .logo-word-main {
    font-size: 1.7rem;
  }

  .logo--lg .logo-word-sub {
    font-size: 0.9rem;
  }
</style>
