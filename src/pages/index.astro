---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site, link } from '../data/site';
import fieldTeam from '../assets/images/field-team-golden-hour.png';
import farmerSpraying from '../assets/images/farmer-spraying.jpg';
import farmerHighlands from '../assets/images/farmer-highlands.png';
import tomatoHarvest from '../assets/images/tomato-harvest.jpg';
import harvestSunset from '../assets/images/harvest-sunset.png';
import farmlandOverlook from '../assets/images/farmland-overlook.png';

// Copy is taken from the Kinectiks brand profile and pitch deck supplied in the project.
// The platform is in development, so this page shows the work and the people, never an unbuilt machine.
const handWork = [
  { src: farmerSpraying, alt: 'A farmer spraying a young maize field from a backpack sprayer', caption: 'Spraying, by hand', widths: [360, 480] },
  { src: farmerHighlands, alt: 'A farmer breaking soil with a hoe at sunset', caption: 'Breaking ground, by hand', widths: [480, 800, 1100] },
  { src: tomatoHarvest, alt: 'Two farmers harvesting tomatoes into woven baskets', caption: 'Harvesting, by hand', widths: [360, 640] },
];

const operations = [
  { name: 'Grow', tasks: ['Crop monitoring', 'Field scouting', 'Weed detection', 'Data collection'] },
  { name: 'Protect', tasks: ['Precision spraying', 'Pest management', 'Field inspection', 'Crop protection'] },
  { name: 'Maintain', tasks: ['Autonomous mowing', 'Vegetation control', 'Grounds maintenance', 'Path and row clearing'] },
  { name: 'Move', tasks: ['Harvest assistance', 'Material transport', 'Farm logistics', 'Payload flexibility'] },
];

const loop = [
  { step: 'Sense', detail: 'LiDAR, cameras, sensors and encoders read the field.' },
  { step: 'Think', detail: 'AI perception and decision making plan the work.' },
  { step: 'Act', detail: 'Autonomous movement carries out the task.' },
];

const requirements = [
  { name: 'Built for Africa', detail: 'Uneven terrain, dust, heat and fragmented fields.' },
  { name: 'Reliable', detail: 'Rugged hardware designed for real-world conditions.' },
  { name: 'Electric', detail: 'Lower operating costs. Better for the environment.' },
  { name: 'Scalable', detail: 'One platform. Many applications.' },
];
---

<Base headerTheme="light" footerCta={false} description={site.description}>
  <!-- ============ HERO: type first, then the field ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-head">
      <p class="hero-coords" data-reveal>
        <span>Agricultural robotics</span>
        <span>{site.location}</span>
        <span>05&deg;36&prime;N 00&deg;11&prime;W</span>
      </p>

      <h1 id="hero-title" class="hero-title" data-reveal style="--delay: 0.06s">
        <span>Autonomous machines</span>
        <span>for African farms<i class="dot" aria-hidden="true"></i></span>
      </h1>

      <div class="hero-row" data-reveal style="--delay: 0.14s">
        <p class="hero-lede">
          We are developing a modular robotic platform that autonomously performs repetitive agricultural and outdoor
          tasks, reducing dependence on manual labour while increasing efficiency.
        </p>
        <div class="hero-actions">
          <a class="btn btn--ink" href={link('/solutions')}>Explore solutions <Arrow /></a>
          <a class="text-link" href={link('/about')}>About Kinectiks <Arrow /></a>
        </div>
      </div>
    </div>

    <figure class="hero-figure">
      <Picture
        src={fieldTeam}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={78}
        widths={[640, 960, 1280, 1671]}
        sizes="100vw"
        alt="A line of farmers weeding a young crop by hand at golden hour"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="wrap hero-caption">
        <span>Fig. 01</span>
        <span>The work we are building machines for.</span>
      </figcaption>
    </figure>
  </section>

  <!-- ============ 01 THE PROBLEM ============ -->
  <section class="section section--dark problem" aria-labelledby="problem-title">
    <div class="wrap">
      <p class="index-line"><b>01</b><span>The problem</span></p>

      <div class="problem-head">
        <h2 id="problem-title" class="problem-title" data-reveal>
          African agriculture still runs on human labour.
        </h2>
        <p class="problem-lede" data-reveal style="--delay: 0.1s">
          Across Africa, millions of farmers still perform by hand the repetitive tasks that machines have automated
          elsewhere for decades. They mow. They spray. They monitor. They harvest.
        </p>
      </div>

      <div class="strip">
        {
          handWork.map((item, i) => (
            <figure class={`strip-item strip-item--${i + 1}`} data-reveal style={`--delay: ${i * 0.08}s`}>
              <div class="strip-media">
                <Picture
                  src={item.src}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  quality={78}
                  widths={item.widths}
                  sizes={i === 1 ? '(max-width: 760px) 100vw, 42vw' : '(max-width: 760px) 50vw, 24vw'}
                  alt={item.alt}
                />
              </div>
              <figcaption>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="problem-foot">
        <p class="conditions" data-reveal>
          And they do it under extreme heat, on difficult terrain, with ageing equipment, rising operating costs and a
          shrinking rural labour force.
        </p>
        <p class="problem-close" data-reveal style="--delay: 0.1s">
          The problem isn&rsquo;t a lack of effort. It&rsquo;s a lack of <span class="accent">appropriate automation.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ STATEMENT ============ -->
  <section class="statement" aria-labelledby="statement-title">
    <div class="statement-media" aria-hidden="true">
      <Picture
        src={harvestSunset}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={78}
        widths={[640, 1024, 1670]}
        sizes="100vw"
        alt=""
      />
    </div>
    <div class="wrap statement-body">
      <h2 id="statement-title" class="statement-title" data-reveal>
        <span>Africa doesn&rsquo;t need more labour.</span>
        <span class="accent">It needs the right machines.</span>
      </h2>
    </div>
  </section>

  <!-- ============ 02 THE PLATFORM ============ -->
  <section class="section platform" aria-labelledby="platform-title">
    <div class="wrap">
      <p class="index-line"><b>02</b><span>The platform</span></p>

      <div class="platform-grid">
        <div class="platform-intro">
          <div class="platform-sticky">
            <p class="status" data-reveal><i aria-hidden="true"></i>In development</p>
            <h2 id="platform-title" class="platform-title" data-reveal>One platform. Multiple operations.</h2>
            <p class="platform-lede" data-reveal style="--delay: 0.08s">
              A single autonomous machine, designed to take on the repetitive outdoor work that holds farms back, from
              scouting crops to moving harvests.
            </p>
            <a class="text-link" href={link('/solutions')} data-reveal style="--delay: 0.12s">See all solutions <Arrow /></a>
          </div>
        </div>

        <ol class="ops" aria-label="Operations the platform is designed for">
          {
            operations.map((op, i) => (
              <li class="op" data-reveal>
                <span class="op-index">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="op-name">{op.name}</h3>
                <ul class="op-tasks">
                  {op.tasks.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="loop" aria-labelledby="loop-title">
        <h3 id="loop-title" class="eyebrow loop-label" data-reveal>How it works</h3>
        <ol class="loop-rail">
          {
            loop.map((item, i) => (
              <li data-reveal style={`--delay: ${i * 0.1}s`}>
                <span class="loop-node" aria-hidden="true" />
                <span class="loop-step">{item.step}</span>
                <p>{item.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="spec" aria-labelledby="spec-title">
        <h3 id="spec-title" class="eyebrow spec-label" data-reveal>Design requirements</h3>
        <dl class="spec-list">
          {
            requirements.map((r, i) => (
              <div data-reveal style={`--delay: ${i * 0.06}s`}>
                <dt>{r.name}</dt>
                <dd>{r.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ 03 WHO WE ARE ============ -->
  <section class="section section--light about" aria-labelledby="about-title">
    <div class="about-grid">
      <figure class="about-figure" data-reveal>
        <Picture
          src={farmlandOverlook}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={78}
          widths={[480, 800, 1200, 1672]}
          sizes="(max-width: 900px) 100vw, 55vw"
          alt="A member of the Kinectiks team looking out over farmland at sunset"
        />
      </figure>

      <div class="about-copy">
        <p class="index-line"><b>03</b><span>Who we are</span></p>
        <h2 id="about-title" class="about-title" data-reveal>African-born. Built in Accra.</h2>
        <p class="about-text" data-reveal>
          Kinectiks Robotics is an African-born robotics and automation company headquartered in Accra, Ghana. We
          design, engineer and deploy intelligent robotic systems that eliminate repetitive physical labour, increase
          productivity and improve quality of life.
        </p>

        <dl class="vm">
          <div data-reveal>
            <dt class="eyebrow">Vision</dt>
            <dd>
              To be Africa&rsquo;s leading robotics company, building intelligent machines that transform how the world
              lives and works.
            </dd>
          </div>
          <div data-reveal style="--delay: 0.08s">
            <dt class="eyebrow">Mission</dt>
            <dd>
              To design and deliver smart, accessible and powerful robotic solutions that put the world in motion, one
              machine at a time.
            </dd>
          </div>
        </dl>

        <a class="text-link" href={link('/about')} data-reveal>More about Kinectiks <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section section--dark contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title" class="contact-title" data-reveal>
        Let&rsquo;s build the right machines for African farms.
      </h2>
      <div class="contact-row" data-reveal style="--delay: 0.08s">
        <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="contact-side">
          <p>Have a question, an idea or a field that needs the right machine? We&rsquo;d like to hear from you.</p>
          <a class="btn btn--primary" href={link('/contact')}>Contact us <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Condensed display face: Archivo pulled narrow and set in capitals, like stencilled equipment marks. */
  .hero-title,
  .problem-title,
  .statement-title,
  .platform-title,
  .op-name,
  .about-title,
  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 78%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
  }

  .hero-coords,
  .hero-caption,
  .strip-item figcaption,
  .status,
  .op-index,
  .op-tasks,
  .loop-step,
  .spec-list dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------------- Hero ---------------- */
  .hero {
    background: var(--cream);
    color: var(--text-on-light);
  }

  .hero-head {
    padding-top: clamp(2rem, 1rem + 3vw, 4rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .hero-coords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    padding-bottom: 1rem;
    margin-bottom: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
    border-bottom: 1px solid var(--rule-light);
    color: var(--muted-on-light);
  }

  .hero-coords span:first-child {
    color: var(--ink);
  }

  .hero-coords span:last-child {
    margin-left: auto;
  }

  .hero-title {
    display: grid;
    font-size: clamp(2.6rem, 8.3vw, 9.6rem);
    font-stretch: 70%;
  }

  .hero-title span:last-child {
    padding-left: 12%;
  }

  .dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    border-radius: 0.04em;
    background: var(--orange);
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem 4rem;
    align-items: end;
    margin-top: clamp(2rem, 1rem + 3vw, 4rem);
    padding-left: 12%;
  }

  .hero-lede {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted-on-light);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .hero-figure {
    position: relative;
    margin: 0;
    height: clamp(22rem, 52vw, 46rem);
    background: var(--ink);
  }

  .hero-figure :global(picture),
  .hero-figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }

  .hero-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: none;
    padding-block: 1.1rem;
    color: var(--text-on-dark);
    background: linear-gradient(to top, rgba(13, 13, 13, 0.55), transparent);
  }

  /* ---------------- 01 Problem ---------------- */
  .problem-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 2rem clamp(2rem, 5vw, 6rem);
    align-items: end;
  }

  .problem-title {
    font-size: clamp(2.6rem, 1rem + 5.4vw, 6.4rem);
  }

  .problem-lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted-on-dark);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
    margin-top: clamp(3.5rem, 2rem + 5vw, 7rem);
  }

  .strip-item {
    margin: 0;
  }

  .strip-item--1 {
    grid-column: 1 / span 3;
    margin-top: clamp(4rem, 10vw, 9rem);
  }

  .strip-item--2 {
    grid-column: 4 / span 6;
  }

  .strip-item--3 {
    grid-column: 10 / span 3;
    margin-top: clamp(8rem, 18vw, 16rem);
  }

  .strip-media {
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--ink-3);
  }

  .strip-item--1 .strip-media {
    aspect-ratio: 3 / 4;
  }

  .strip-item--2 .strip-media,
  .strip-item--3 .strip-media {
    aspect-ratio: 4 / 5;
  }

  .strip-media :global(picture),
  .strip-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strip-item figcaption {
    display: flex;
    gap: 0.9rem;
    padding-top: 0.9rem;
    color: var(--text-on-dark);
  }

  .strip-item figcaption span {
    color: var(--orange);
  }

  .problem-foot {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 2rem clamp(2rem, 5vw, 6rem);
    align-items: end;
    margin-top: clamp(4rem, 2rem + 6vw, 8rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule-dark);
  }

  .conditions {
    max-width: 30rem;
    color: var(--muted-on-dark);
  }

  .problem-close {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 100%;
    font-size: var(--step-3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* ---------------- Statement ---------------- */
  .statement {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(30rem, 90svh, 60rem);
    color: var(--text-on-dark);
    background: var(--ink);
    isolation: isolate;
  }

  .statement-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .statement-media :global(picture),
  .statement-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .statement-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(13, 13, 13, 0.6), rgba(13, 13, 13, 0) 65%),
      linear-gradient(to top, rgba(13, 13, 13, 0.9) 10%, rgba(13, 13, 13, 0.25) 60%, rgba(13, 13, 13, 0.1));
  }

  .statement-body {
    padding-block: var(--section) clamp(3rem, 2rem + 4vw, 6rem);
  }

  .statement-title {
    display: grid;
    font-size: clamp(2.7rem, 0.8rem + 7vw, 8.4rem);
  }

  /* ---------------- 02 Platform ---------------- */
  .platform {
    background: var(--white);
    color: var(--text-on-light);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3rem clamp(2rem, 6vw, 7rem);
  }

  .platform-sticky {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--rule-light);
    border-radius: 4px;
  }

  .status i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--orange);
  }

  .platform-title {
    font-size: clamp(2.6rem, 1.2rem + 4.4vw, 5.6rem);
  }

  .platform-lede {
    max-width: 30rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted-on-light);
  }

  .ops {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .op {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1rem 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border-bottom: 1px solid var(--rule-light);
  }

  .op-index {
    color: var(--muted-on-light);
  }

  .op-name {
    font-size: clamp(2.4rem, 1.4rem + 2.4vw, 3.8rem);
    transition: color 0.3s var(--ease);
  }

  .op:hover .op-name {
    color: var(--orange);
  }

  .op-tasks {
    display: grid;
    gap: 0.45rem;
    font-size: 0.74rem;
    color: var(--muted-on-light);
  }

  .loop {
    margin-top: clamp(5rem, 3rem + 6vw, 9rem);
  }

  .loop-label,
  .spec-label {
    margin-bottom: 2rem;
    color: var(--muted-on-light);
  }

  .loop-rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .loop-rail::before {
    content: '';
    position: absolute;
    top: 13px;
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--ink);
  }

  .loop-rail li {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding-right: 2rem;
  }

  .loop-node {
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--ink);
    border-radius: 7px;
    background: var(--white);
  }

  .loop-rail li:last-child .loop-node {
    background: var(--orange);
    border-color: var(--orange);
  }

  .loop-step {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--ink);
  }

  .loop-rail p {
    max-width: 22rem;
    color: var(--muted-on-light);
  }

  .spec {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1rem clamp(2rem, 6vw, 7rem);
    margin-top: clamp(5rem, 3rem + 6vw, 9rem);
  }

  .spec-list {
    margin: 0;
    border-top: 1.5px solid var(--ink);
  }

  .spec-list div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 0.5rem 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule-light);
  }

  .spec-list dt {
    color: var(--ink);
  }

  .spec-list dd {
    margin: 0;
    color: var(--muted-on-light);
  }

  /* ---------------- 03 About ---------------- */
  .about {
    padding-block: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    align-items: stretch;
  }

  .about-figure {
    position: relative;
    margin: 0;
    min-height: 36rem;
    background: var(--ink);
  }

  .about-figure :global(picture),
  .about-figure :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 92% 50%;
  }

  .about-copy {
    max-width: 44rem;
    padding: var(--section) var(--gutter) var(--section) clamp(2rem, 5vw, 6rem);
  }

  .about-title {
    font-size: clamp(2.6rem, 1.2rem + 4vw, 5.2rem);
  }

  .about-text {
    margin-top: 1.75rem;
    color: var(--muted-on-light);
  }

  .vm {
    display: grid;
    gap: 2rem;
    margin: 2.75rem 0;
  }

  .vm div {
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule-light);
  }

  .vm dt {
    color: var(--muted-on-light);
  }

  .vm dd {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 100%;
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ---------------- Contact ---------------- */
  .contact-title {
    max-width: 14ch;
